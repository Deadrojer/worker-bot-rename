# ═══════════════════════════════════════════════════════════════
# Worker Bot — Environment Variables
# Each Worker deployment needs its own BOT_TOKEN and WORKER_ID.
# All other values can be shared from the same template.
# ═══════════════════════════════════════════════════════════════

# ── Telegram API credentials (same as Manager) ───────────────
API_ID=
API_HASH=

# ── This Worker's Bot Token (unique per worker) ───────────────
BOT_TOKEN=

# ── Shared String Session (same value as Manager) ────────────
# Protocol I/O only — NEVER used for file downloads/uploads.
STRING_SESSION=

# ── Worker Identity ───────────────────────────────────────────
# Must be unique across all workers: worker_01, worker_02, …
WORKER_ID=worker_01

# Max concurrent jobs this worker handles at once
WORKER_CONCURRENCY=3

WORKER_VERSION=1.0.0

# ── Channels / Groups (same as Manager) ─────────────────────
WORKER_CONTROL_GROUP_ID=
WORKER_OUTPUT_CHANNEL_ID=

# ── Database (same URI and name as Manager) ──────────────────
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/
DB_NAME=DistributedRenameBot

# ── Heartbeat ────────────────────────────────────────────────
HEARTBEAT_INTERVAL=30
WORKER_OFFLINE_TIMEOUT=120

# ── ImgBB (thumbnail download; same key as Manager) ──────────
IMGBB_API_KEY=

# ── File size limits ─────────────────────────────────────────
BOT_MAX_SIZE=2000000000

# ── Health check (Koyeb/Render keep-alive) ───────────────────
# Use a different port per worker if running on the same host
PORT=8001

# ── Graceful shutdown ────────────────────────────────────────
SHUTDOWN_GRACE_SECONDS=60
